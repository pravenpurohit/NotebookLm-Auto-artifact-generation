{
  "enabled": true,
  "name": "Sync Steering on Spec Change",
  "description": "When requirement.md, design.md, or tasks.md files are edited, reviews existing steering files in .kiro/steering/ and determines if any need to be updated or if new steering files should be created to reflect the changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/requirement.md",
      "**/design.md",
      "**/tasks.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A spec file (requirement.md, design.md, or tasks.md) was just edited. Step back and review all existing steering files in .kiro/steering/. Compare them against the current state of the spec files to determine: 1) Do any existing steering files need to be updated to reflect the changes? 2) Are there new steering files that should be created to cover new patterns, standards, or guidance introduced by the spec changes? Take action accordingly — update or create steering files as needed."
  }
}